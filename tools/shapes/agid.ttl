@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix agid:     <urn:validatore-dcatapit:shapes:agid#> .
@prefix ft:       <http://publications.europa.eu/resource/authority/file-type/> .
@prefix theme:    <http://publications.europa.eu/resource/authority/data-theme/> .

# Indicazioni operative AgID per un harvesting pulito su dati.gov.it.
# Non sono regole DCAT-AP / DCAT-AP_IT: sono criteri di gestione del catalogo
# nazionale (identificativi univoci e riconducibili all'ente, contatti utili).
# Per questo hanno tutte gravita' sh:Info ("indicazione"): non rendono il
# catalogo non conforme.
#
# Il controllo "il prefisso dell'identificativo del dataset coincide con il
# codice IPA del titolare" non e' esprimibile in SHACL Core: lo fanno a parte
# il validatore web (engine.js, agidChecks) e lo script Python (agid_checks).

# ---------------------------------------------------------------- DATASET
agid:Dataset a sh:NodeShape ;
  rdfs:label "Dataset - identificativo" ;
  sh:targetClass dcat:Dataset ;
  sh:property
    [ sh:path dct:identifier ;
      sh:pattern "^[A-Za-z0-9_]+:[A-Za-z0-9_.-]+$" ;
      sh:severity sh:Info ;
      sh:message "Identificativo del dataset non nel formato codiceIPA:identificativo (dopo i due punti solo lettere, cifre, punto, - e _; niente spazi, accenti o altri caratteri)" ] ,
    # parole chiave: richieste per l'harvesting su dati.gov.it (e criterio MQA "Keyword usage")
    [ sh:path dcat:keyword ;
      sh:minCount 1 ;
      sh:severity sh:Info ;
      sh:message "Dataset senza parole chiave (dcat:keyword): sono richieste per l'harvesting su dati.gov.it e valutate dall'MQA di data.europa.eu" ] .

# ---------------------------------------------------------------- TITOLARE
agid:Holder a sh:NodeShape ;
  rdfs:label "Titolare - codice IPA" ;
  sh:targetObjectsOf dct:rightsHolder ;
  sh:property
    [ sh:path dct:identifier ;
      sh:pattern "^[A-Za-z0-9_]+$" ;
      sh:severity sh:Info ;
      sh:message "Identificativo del titolare non nel formato del codice IPA (solo lettere, cifre e _; niente due punti, spazi o altri caratteri)" ] .

# ---------------------------------------------------------------- CATALOGO
# L'email dell'editore del catalogo (e dei sottocataloghi) deve essere una casella
# ordinaria (PEO), non una PEC: serve a contattare chi gestisce il catalogo.
# Riconoscimento euristico: "pec" come parte separata dell'indirizzo, "cert."
# e i principali gestori PEC.
agid:Catalog a sh:NodeShape ;
  rdfs:label "Catalogo - email dell'editore" ;
  sh:targetClass dcat:Catalog ;
  sh:property
    [ sh:path ( dct:publisher foaf:mbox ) ;
      sh:pattern "^(?!.*((^|[@.:_-])pec([.@_-]|$)|(^|[@.])(cert|postacert|pcert)\\.|legalmail\\.|arubapec\\.|postecert\\.|sicurezzapostale\\.|gigapec\\.|mypec\\.|casellapec\\.|pecmail\\.|cgn\\.legalmail|pec\\.it)).*$" ;
      sh:flags "i" ;
      sh:severity sh:Info ;
      sh:message "L'email dell'editore del catalogo sembra una PEC: indicare una casella ordinaria (PEO) di chi gestisce il catalogo" ] .

# ---------------------------------------------------------------- VALORI SEGNAPOSTO
# OP_DATPRO ("dati provvisori") e' un valore valido dei vocabolari EU, quindi passa
# la validazione, ma non dice nulla: CKAN/dcatapit lo assegnano quando il tema manca,
# e come formato e' un ripiego. ARC (archivio dell'Internet Archive) e' quasi sempre
# scelto per errore. Ogni valore e' contato nel riepilogo.
agid:ThemeSegnaposto a sh:NodeShape ;
  rdfs:label "Dataset - tema segnaposto" ;
  sh:targetClass dcat:Dataset ;
  sh:property
    [ sh:path dcat:theme ;
      sh:not [ sh:in ( theme:OP_DATPRO ) ] ;
      sh:severity sh:Info ;
      sh:message "Tema OP_DATPRO («dati provvisori»): e' il valore che CKAN assegna quando il tema manca. Indicare uno dei 13 temi del vocabolario data-theme (es. GOVE, ENVI, EDUC)" ] .

agid:FormatoSegnaposto a sh:NodeShape ;
  rdfs:label "Distribuzione - formato segnaposto o errato" ;
  sh:targetClass dcat:Distribution ;
  sh:property
    [ sh:path dct:format ;
      sh:not [ sh:in ( ft:OP_DATPRO ) ] ;
      sh:severity sh:Info ;
      sh:message "Formato OP_DATPRO («dati provvisori»): e' un segnaposto, indicare il formato reale del file (es. CSV, JSON, PDF, ZIP)" ] ,
    [ sh:path dct:format ;
      sh:not [ sh:in ( ft:ARC ) ] ;
      sh:severity sh:Info ;
      sh:message "Formato ARC: e' il formato d'archivio dell'Internet Archive, quasi sempre scelto per errore. Verificare il formato reale del file (es. ZIP, SHP, GeoJSON)" ] .
